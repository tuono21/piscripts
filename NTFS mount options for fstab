root@NZXT:/# cat /etc/fstab


# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# / was on /dev/nvme0n1p3 during installation
UUID=1397be19-7c3b-4cce-bac6-7c6b7767cba4 /               ext4    errors=remount-ro 0       1
# /boot/efi was on /dev/nvme0n1p1 during installation
UUID=F5F5-C550  /boot/efi       vfat    umask=0077      0       1
/swapfile                                 none            swap    sw              0       0
LABEL=NVME1_Work_430GB /mnt/NVME1_Work_430GB auto nosuid,nodev,nofail,x-gvfs-show 0 0
LABEL=NVME2_Work_500GB /mnt/NVME2_Work_500GB auto nosuid,nodev,nofail,x-gvfs-show 0 0
LABEL=WD_8TB /mnt/WD_8TB auto defaults,utf8,umask=000,uid=1000,windows_names,nofail,x-gvfs-show,noatime,nosuid,nodev 0 0
LABEL=WD_5TB /mnt/WD_5TB auto defaults,utf8,umask=000,uid=1000,windows_names,nofail,x-gvfs-show,noatime,nosuid,nodev 0 0
LABEL=WD_4TB /mnt/WD_4TB auto defaults,utf8,umask=000,uid=1000,windows_names,nofail,x-gvfs-show,noatime,nosuid,nodev 0 0
LABEL=Seagate_4TB /mnt/Seagate_4TB auto defaults,utf8,umask=000,uid=1000,windows_names,nofail,x-gvfs-show,noatime,nosuid,nodev 0 0
#
#
#defaults,utf8,umask=000,uid=1000,windows_names,nofail,x-gvfs-show,noatime,nosuid,nodev
#
#defaults: A shorthand for rw, suid, dev, exec, auto, nouser, async.
#utf8: Explicitly enables UTF-8 encoding for filenames (often used instead of nls=utf8).
#uid=1000 and umask=000: Specifically for NTFS drives to assign ownership to the first user and allow full read/write permissions as NTFS does not store Linux permissions.
#windows_names: Prevents creating files with characters invalid in Windows.
#nofail: Prevents boot failure if the drive is missing.
#x-gvfs-show: Displays the drive in the user interface (file manager).
#atime, noatime, diratime, nodiratime: Control updates to inode access times for files and directories.
#nosuid,nodev: Disables set-user-identifier and special device handling for security.



